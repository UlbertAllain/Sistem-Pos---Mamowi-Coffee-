{
  "name": "mamowi-coffee-pos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "audit:scope": "node scripts/check-scope.mjs",
    "check": "npm run audit:scope && npm run audit:architecture && npm run audit:rules-static && npm run lint && npm run typecheck && npm run test && npm run test:rules && npm run build",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "test:rules": "firebase emulators:exec --project demo-mamowi --only firestore \"node --test tests/firestore/*.test.mjs\"",
    "preflight": "node scripts/preflight.mjs",
    "bootstrap": "node scripts/bootstrap-store.mjs",
    "audit:architecture": "node scripts/check-architecture.mjs",
    "audit:rules-static": "node scripts/check-rules-static.mjs"
  },
  "dependencies": {
    "firebase": "12.16.0",
    "lucide-react": "1.27.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.7",
    "zod": "4.4.3",
    "zustand": "5.0.14",
    "firebase-admin": "14.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "firebase-tools": "15.24.0",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0 <27",
    "npm": ">=10"
  }
}
