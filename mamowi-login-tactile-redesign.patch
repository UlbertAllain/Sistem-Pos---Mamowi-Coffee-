+  font-weight: 900;
+  letter-spacing: .11em;
+  text-transform: uppercase;
+}
+
+.tactile-login-field input {
+  width: 100%;
+  height: 48px;
+  padding: 0 14px;
+  outline: 0;
+  border: 1px solid #69736c;
+  border-radius: 2px;
+  color: var(--ink);
+  background: #fffdf7;
+  box-shadow: inset 0 -2px 0 rgba(23, 35, 30, .04);
+  font-size: 13px;
+  transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
+}
+
+.tactile-login-field input::placeholder {
+  color: #9a9d96;
+}
+
+.tactile-login-field input:focus {
+  border-color: var(--primary);
+  box-shadow: 2px 3px 0 rgba(38, 122, 72, .16);
+  transform: translate(-1px, -1px);
+}
+
+.tactile-login-field input:disabled {
+  cursor: not-allowed;
+  background: #f0ece3;
+}
+
+.tactile-login-password {
+  position: relative;
+}
+
+.tactile-login-password input {
+  padding-right: 48px;
+}
+
+.tactile-login-password button {
+  position: absolute;
+  top: 50%;
+  right: 6px;
+  width: 36px;
+  height: 36px;
+  display: grid;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: 2px;
+  color: #647068;
+  background: transparent;
+  transform: translateY(-50%);
+}
+
+.tactile-login-password button:hover:not(:disabled) {
+  color: var(--primary);
+  background: #e8eee5;
+}
+
+.tactile-login-alert {
+  display: grid;
+  grid-template-columns: 24px minmax(0, 1fr);
+  gap: 10px;
+  align-items: start;
+  padding: 11px 12px;
+  border: 1px solid var(--danger);
+  border-radius: 2px;
+  color: #7d2825;
+  background: var(--danger-soft);
+  box-shadow: 2px 3px 0 rgba(161, 56, 50, .1);
+}
+
+.tactile-login-alert > span {
+  width: 22px;
+  height: 22px;
+  display: grid;
+  place-items: center;
+  border: 1px solid currentColor;
+  border-radius: 50%;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 13px;
+  font-weight: 800;
+}
+
+.tactile-login-alert p {
+  margin: 2px 0 0;
+  color: inherit;
+  font-size: 11px;
+  line-height: 1.45;
+}
+
+.tactile-login-submit.button {
+  width: 100%;
+  min-height: 50px;
+  margin-top: 2px;
+  border: 1px solid var(--ink);
+  border-radius: 2px;
+  color: #fffaf0;
+  background: var(--primary);
+  box-shadow: 3px 4px 0 var(--ink);
+  font-size: 12px;
+  font-weight: 900;
+  letter-spacing: .025em;
+}
+
+.tactile-login-submit.button:hover:not(:disabled) {
+  background: var(--primary-hover);
+  box-shadow: 2px 3px 0 var(--ink);
+  transform: translate(1px, 1px);
+}
+
+.tactile-login-submit.button:active:not(:disabled) {
+  box-shadow: 0 0 0 var(--ink);
+  transform: translate(3px, 4px);
+}
+
+.tactile-login-security {
+  display: flex;
+  gap: 8px;
+  align-items: flex-start;
+  margin-top: 22px;
+  padding-top: 16px;
+  border-top: 1px dashed rgba(23, 35, 30, .25);
+  color: #667169;
+}
+
+.tactile-login-security svg {
+  flex: 0 0 auto;
+  margin-top: 1px;
+  color: var(--primary);
+}
+
+.tactile-login-security span {
+  font-size: 9px;
+  line-height: 1.5;
+}
+
+.tactile-login-help {
+  position: relative;
+  z-index: 1;
+  margin: 22px 10px 0;
+  color: #6d746e;
+  font-size: 9px;
+  line-height: 1.5;
+  text-align: center;
+}
+
+@media (max-width: 1040px) {
+  .tactile-login-page {
+    padding: 20px;
+  }
+
+  .tactile-login-board {
+    grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
+    gap: 16px;
+  }
+
+  .tactile-login-story {
+    min-height: 650px;
+    padding: 30px;
+  }
+
+  .tactile-login-title-wrap {
+    width: 100%;
+    padding-top: 48px;
+    padding-right: 120px;
+  }
+
+  .tactile-login-title-wrap h1 {
+    font-size: clamp(44px, 6vw, 68px);
+  }
+
+  .tactile-login-note {
+    top: 165px;
+    right: 22px;
+    width: 145px;
+  }
+
+  .tactile-login-feature {
+    min-height: 154px;
+    padding: 18px 13px;
+  }
+
+  .tactile-login-access {
+    padding: 50px 20px 28px;
+  }
+
+  .tactile-login-card {
+    padding: 27px 24px;
+  }
+}
+
+@media (max-width: 820px) {
+  .tactile-login-page {
+    padding: 16px;
+  }
+
+  .tactile-login-header {
+    margin-bottom: 16px;
+  }
+
+  .tactile-login-system-status {
+    display: none;
+  }
+
+  .tactile-login-board {
+    grid-template-columns: 1fr;
+  }
+
+  .tactile-login-story {
+    min-height: auto;
+    padding: 28px 26px 90px;
+  }
+
+  .tactile-login-title-wrap {
+    padding-right: 150px;
+  }
+
+  .tactile-login-feature-grid {
+    margin-top: 44px;
+  }
+
+  .tactile-login-story-footer {
+    right: 26px;
+    left: 26px;
+  }
+
+  .tactile-login-access {
+    min-height: 610px;
+    padding: 70px 24px 36px;
+  }
+
+  .tactile-login-card {
+    width: min(480px, 100%);
+    margin: 0 auto;
+  }
+}
+
+@media (max-width: 600px) {
+  .tactile-login-page {
+    padding: 12px;
+  }
+
+  .tactile-login-header {
+    min-height: 52px;
+  }
+
+  .tactile-login-brand strong {
+    font-size: 19px;
+  }
+
+  .tactile-login-brand span:last-child {
+    font-size: 7px;
+  }
+
+  .tactile-login-story {
+    padding: 24px 20px 72px;
+    box-shadow: 4px 5px 0 rgba(23, 35, 30, .11);
+  }
+
+  .tactile-login-story-topline span:last-child {
+    display: none;
+  }
+
+  .tactile-login-title-wrap {
+    padding-top: 38px;
+    padding-right: 0;
+  }
+
+  .tactile-login-title-wrap h1 {
+    font-size: clamp(44px, 14vw, 62px);
+  }
+
+  .tactile-login-intro {
+    font-size: 12px;
+  }
+
+  .tactile-login-note {
+    position: relative;
+    top: auto;
+    right: auto;
+    width: min(210px, 78%);
+    margin: 34px 0 0 auto;
+  }
+
+  .tactile-login-feature-grid {
+    grid-template-columns: 1fr;
+    margin-top: 38px;
+  }
+
+  .tactile-login-feature {
+    min-height: auto;
+    padding: 17px 14px;
+  }
+
+  .tactile-login-feature + .tactile-login-feature {
+    border-top: 1px solid rgba(23, 35, 30, .25);
+    border-left: 0;
+  }
+
+  .tactile-login-sketch {
+    display: none;
+  }
+
+  .tactile-login-story-footer span:last-child {
+    display: none;
+  }
+
+  .tactile-login-access {
+    min-height: auto;
+    padding: 66px 16px 28px;
+  }
+
+  .tactile-login-access::before {
+    inset: 10px;
+  }
+
+  .tactile-login-access-label {
+    top: 22px;
+    right: 18px;
+  }
+
+  .tactile-login-card {
+    padding: 28px 20px 24px;
+  }
+
+  .tactile-login-card-heading h2 {
+    font-size: 32px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tactile-login-field input,
+  .tactile-login-submit.button {
+    transition: none;
+  }
+}
