# Firebase Web SDK (aman dipakai di browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORE_ID=mamowi-coffee
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Firebase Admin SDK (SERVER ONLY — jangan pakai prefix NEXT_PUBLIC)
# Ambil dari Firebase Console > Project settings > Service accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tempel private key termasuk BEGIN/END. Gunakan \n bila disimpan satu baris.
FIREBASE_ADMIN_PRIVATE_KEY=

# Hanya dipakai script migrasi lokal. Jangan commit nilai sebenarnya.
MIGRATION_ADMIN_EMAIL=
MIGRATION_ADMIN_PASSWORD=

# Optional product image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
