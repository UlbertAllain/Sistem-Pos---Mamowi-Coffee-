+.tactile-command-bar.pos-command-bar {
+  align-items: stretch;
+  margin-bottom: 10px;
+}
+
+.tactile-search.pos-search input {
+  height: 49px;
+  padding: 0 62px 0 42px;
+  border: 1px solid var(--ink);
+  border-radius: 3px;
+  background: #fffdf8;
+  box-shadow: inset 0 -3px 0 rgba(38, 122, 72, .05);
+}
+
+.tactile-search.pos-search svg {
+  left: 13px;
+  color: var(--ink);
+}
+
+.tactile-search kbd {
+  position: absolute;
+  top: 50%;
+  right: 10px;
+  padding: 4px 6px;
+  color: #6d756e;
+  border: 1px solid rgba(23, 35, 30, .25);
+  background: #f2ede3;
+  font-family: inherit;
+  font-size: 8px;
+  transform: translateY(-50%);
+}
+
+.tactile-result-note.pos-result-count {
+  width: 108px;
+  height: 49px;
+  display: grid;
+  grid-template-columns: auto 1fr;
+  gap: 7px;
+  padding: 0 10px;
+  color: var(--ink);
+  border: 1px solid rgba(91, 73, 20, .36);
+  border-radius: 1px;
+  background: var(--sticky);
+  box-shadow: 2px 3px 0 rgba(91, 73, 20, .12);
+  transform: rotate(.7deg);
+}
+
+.tactile-result-note.pos-result-count strong {
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 16px;
+}
+
+.tactile-result-note.pos-result-count span {
+  color: #5d511f;
+  font-size: 8px;
+  line-height: 1.15;
+}
+
+.tactile-category-strip.pos-category-strip {
+  gap: 6px;
+  padding: 3px 0 14px;
+}
+
+.tactile-category-strip .pos-category {
+  min-height: 31px;
+  padding: 0 11px;
+  color: #526057;
+  border: 1px solid rgba(23, 35, 30, .28);
+  border-radius: 3px;
+  background: #f3eee4;
+  font-size: 9px;
+  font-weight: 800;
+}
+
+.tactile-category-strip .pos-category:hover {
+  color: var(--ink);
+  border-color: var(--ink);
+}
+
+.tactile-category-strip .pos-category.active {
+  color: #fff;
+  border-color: var(--ink);
+  background: var(--primary);
+  box-shadow: 2px 2px 0 var(--ink);
+}
+
+.tactile-product-grid.pos-product-grid {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 9px;
+}
+
+.tactile-product-card.pos-product-card {
+  position: relative;
+  min-height: 178px;
+  display: grid;
+  grid-template-columns: 75px minmax(0, 1fr);
+  align-content: stretch;
+  overflow: visible;
+  padding: 9px;
+  text-align: left;
+  border: 1px solid rgba(23, 35, 30, .55);
+  border-radius: 4px;
+  background: #fffaf0;
+  box-shadow: 2px 3px 0 rgba(23, 35, 30, .09);
+  transition: transform .13s ease, box-shadow .13s ease;
+}
+
+.tactile-product-card.pos-product-card:nth-child(5n + 2) {
+  background: #f2eee1;
+}
+
+.tactile-product-card.pos-product-card:nth-child(5n + 4) {
+  background: #edf1e7;
+}
+
+.tactile-product-card.pos-product-card:hover:not(:disabled) {
+  z-index: 3;
+  border-color: var(--ink);
+  box-shadow: 4px 5px 0 var(--ink);
+  transform: translate(-1px, -1px) rotate(-.3deg);
+}
+
+.tactile-product-card.pos-product-card:disabled {
+  opacity: .48;
+  filter: grayscale(.4);
+}
+
+.product-card-index {
+  position: absolute;
+  top: 7px;
+  left: 8px;
+  z-index: 4;
+  color: var(--primary);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 9px;
+  font-weight: 800;
+}
+
+.tactile-product-media.pos-product-media {
+  width: 75px;
+  height: 100%;
+  min-height: 158px;
+  border: 1px solid rgba(23, 35, 30, .28);
+  border-radius: 2px;
+  color: var(--primary);
+  background: #e7e2d6;
+}
+
+.tactile-product-media.pos-product-media::after {
+  display: none;
+}
+
+.tactile-product-media.pos-product-media img {
+  filter: saturate(.88) contrast(.96);
+}
+
+.tactile-product-card.pos-product-card:hover .pos-product-media img {
+  transform: none;
+}
+
+.tactile-product-info.pos-product-info {
+  align-content: end;
+  gap: 7px;
+  padding: 24px 4px 4px 10px;
+}
+
+.product-meta-line {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 7px;
+}
+
+.product-meta-line span,
+.product-meta-line small {
+  overflow: hidden;
+  color: #6b756e;
+  font-size: 7px;
+  font-weight: 900;
+  letter-spacing: .08em;
+  text-overflow: ellipsis;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
+.product-meta-line small {
+  color: #96978f;
+}
+
+.tactile-product-info.pos-product-info > strong {
+  min-height: auto;
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 14px;
+  line-height: 1.2;
+}
+
+.product-price-line {
+  padding-top: 7px;
+  border-top: 1px solid rgba(23, 35, 30, .17);
+}
+
+.tactile-product-info.pos-product-info b {
+  color: var(--ink);
+  font-size: 11px;
+}
+
+.tactile-product-card .add-product {
+  width: 26px;
+  height: 26px;
+  border: 1px solid var(--ink);
+  border-radius: 50%;
+  color: #fff;
+  background: var(--primary);
+}
+
+.tactile-stock-note.stock-pill {
+  top: -6px;
+  right: 7px;
+  min-height: 21px;
+  padding: 0 7px;
+  color: #4e451d;
+  border: 1px solid rgba(90, 73, 24, .3);
+  border-radius: 1px;
+  background: var(--sticky);
+  font-size: 7px;
+  letter-spacing: .05em;
+  transform: rotate(1.7deg);
+  backdrop-filter: none;
+}
+
+.tactile-stock-note.stock-pill.out {
+  color: #812f2a;
+  border-color: rgba(129, 47, 42, .3);
+  background: #f0b0a5;
+}
+
+.tactile-empty-board {
+  min-height: 300px;
+}
+
+/* Order board */
+.tactile-order-board.pos-cart-panel {
+  top: 88px;
+  min-height: calc(100vh - 111px);
+  max-height: calc(100vh - 99px);
+  overflow: hidden;
+  color: var(--ink);
+}
+
+.order-board-label {
+  padding: 13px 17px 0;
+}
+
+.tactile-cart-head.pos-cart-head {
+  padding: 8px 17px 14px;
+  border-bottom: 1px solid rgba(23, 35, 30, .42);
+}
+
+.tactile-cart-head.pos-cart-head h2 {
+  color: var(--ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 25px;
+  letter-spacing: -.04em;
+}
+
+.tactile-cart-head.pos-cart-head .eyebrow {
+  color: var(--primary);
+  font-size: 8px;
+}
+
+.tactile-cart-count.cart-count {
+  min-height: 29px;
+  padding: 0 9px;
+  color: #554b1c;
+  border: 1px solid rgba(88, 73, 22, .35);
+  border-radius: 1px;
+  background: var(--sticky);
+  box-shadow: 2px 2px 0 rgba(88, 73, 22, .12);
+  transform: rotate(1deg);
+}
+
+.tactile-cart-body.pos-cart-body {
+  padding: 11px 13px;
+}
+
+.tactile-empty-cart.pos-empty-cart {
+  min-height: 280px;
+  color: #778078;
+}
+
+.tactile-empty-cart.pos-empty-cart svg {
+  color: var(--primary);
+}
+
+.tactile-empty-cart.pos-empty-cart strong {
+  color: var(--ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 15px;
+}
+
+.tactile-empty-cart.pos-empty-cart p {
+  color: #707970;
+}
+
+.empty-cart-note {
+  margin-top: 22px;
+  color: var(--primary);
+  font-family: "Segoe Print", "Bradley Hand", "Marker Felt", cursive;
+  font-size: 11px;
+  transform: rotate(-4deg);
+}
+
+.tactile-cart-list.pos-cart-list {
+  gap: 7px;
+}
+
+.tactile-cart-item.pos-cart-item {
+  position: relative;
+  grid-template-columns: 31px 43px minmax(0, 1fr) auto;
+  gap: 8px;
+  padding: 9px;
+  border: 1px solid rgba(23, 35, 30, .35);
+  border-radius: 3px;
+  background: rgba(255, 253, 247, .82);
+}
+
+.tactile-cart-item.pos-cart-item:nth-child(even) {
+  background: rgba(236, 239, 229, .9);
+}
+
+.cart-item-index {
+  align-self: start;
+  padding-top: 3px;
+  color: var(--primary);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 9px;
+  font-weight: 800;
+}
+
+.tactile-cart-thumb.cart-thumb {
+  width: 43px;
+  height: 43px;
+  border: 1px solid rgba(23, 35, 30, .3);
+  border-radius: 2px;
+  color: var(--primary);
+  background: #e8e3d7;
+}
+
+.tactile-cart-item .cart-item-copy strong {
+  color: var(--ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 11px;
+}
+
+.tactile-cart-item .cart-item-copy span {
+  color: #6e766f;
+  font-size: 8px;
+}
+
+.tactile-cart-item .cart-line-total {
+  color: var(--ink);
+  font-size: 10px;
+}
+
+.tactile-quantity-control.cart-quantity {
+  grid-column: 3;
+  border: 1px solid var(--ink);
+  border-radius: 2px;
+  background: #fffaf0;
+}
+
+.tactile-quantity-control.cart-quantity button {
+  color: var(--ink);
+}
+
+.tactile-quantity-control.cart-quantity button:hover {
+  background: var(--primary-soft);
+}
+
+.tactile-quantity-control.cart-quantity span {
+  color: var(--ink);
+}
+
+.tactile-cart-item .cart-remove {
+  grid-column: 4;
+  color: #7b736b;
+  border-radius: 2px;
+}
+
+.tactile-cart-summary.pos-cart-summary {
+  gap: 10px;
+  padding: 15px 17px 17px;
+  border-top: 1px solid var(--ink);
+  background: #e8e2d5;
+}
+
+.tactile-cart-summary .summary-row,
+.tactile-cart-summary .summary-row strong {
+  color: var(--ink);
+  font-size: 10px;
+}
+
+.tactile-discount-field.discount-field > span,
+.tactile-discount-field.discount-field small {
+  color: #687168;
+}
+
+.tactile-discount-field.discount-field input {
+  height: 34px;
+  color: var(--ink);
+  border-color: rgba(23, 35, 30, .4);
+  background: #fffaf0;
+}
+
+.tactile-grand-total.pos-grand-total {
+  padding-top: 11px;
+  border-top: 1px dashed rgba(23, 35, 30, .5);
+}
+
+.tactile-grand-total.pos-grand-total span {
+  color: #5f695f;
+}
+
+.tactile-grand-total.pos-grand-total strong {
+  color: var(--ink);
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 26px;
+}
+
+.tactile-cart-summary .clear-cart {
+  color: #687168;
+}
+
+.tactile-cart-summary .clear-cart:hover {
+  color: var(--danger);
+}
+
+/* Payment */
+.tactile-payment-total.payment-total-card {
+  border: 1px solid var(--ink);
+  border-radius: 4px;
+  color: var(--ink);
+  background: var(--sticky);
+  box-shadow: 3px 4px 0 rgba(23, 35, 30, .12);
+}
+
+.tactile-payment-total.payment-total-card span,
+.tactile-payment-total.payment-total-card strong {
+  color: var(--ink);
+}
+
+.tactile-payment-methods .payment-method {
+  border: 1px solid rgba(23, 35, 30, .35);
+  border-radius: 4px;
+  background: #fffaf0;
+}
+
+.tactile-payment-methods .payment-method-active {
+  border-color: var(--ink);
+  background: var(--primary-soft);
+  box-shadow: 2px 3px 0 var(--ink);
+}
+
+.tactile-change-card.change-card {
+  border: 1px solid var(--primary);
+  border-radius: 4px;
+  background: var(--primary-soft);
+}
+
+.quick-cash button {
+  border-color: rgba(23, 35, 30, .4);
+  border-radius: 3px;
+  background: #fffaf0;
+}
+
+/* Responsive */
+@media (max-width: 1360px) {
+  .tactile-product-grid.pos-product-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+}
+
+@media (max-width: 1120px) {
+  .tactile-pos-workspace.pos-workspace {
+    grid-template-columns: minmax(0, 1fr) 350px;
+  }
+
+  .tactile-product-card.pos-product-card {
+    grid-template-columns: 68px minmax(0, 1fr);
+  }
+
+  .tactile-product-media.pos-product-media {
+    width: 68px;
+  }
+}
+
+@media (max-width: 1024px) {
+  .tactile-sidebar.sidebar {
+    width: 248px;
+  }
+
+  .app-main {
+    margin-left: 0;
+  }
+
+  .tactile-pos-workspace.pos-workspace {
+    grid-template-columns: 1fr;
+  }
+
+  .tactile-order-board.pos-cart-panel {
+    position: relative;
+    top: auto;
+    min-height: 520px;
+    max-height: none;
+  }
+}
+
+@media (max-width: 720px) {
+  .tactile-topbar.app-topbar {
+    height: 62px;
+    padding: 0 14px;
+  }
+
+  .store-live-status,
+  .topbar-user-copy {
+    display: none !important;
+  }
+
+  .page-container {
+    padding: 18px 12px 32px;
+  }
+
+  .pos-editorial-header {
+    grid-template-columns: 28px minmax(0, 1fr);
+  }
+
+  .editorial-note {
+    grid-column: 1 / -1;
+    width: min(260px, 100%);
+    margin-left: 28px;
+  }
+
+  .tactile-menu-board.pos-catalog {
+    padding: 12px;
+  }
+
+  .board-doodle,
+  .tactile-result-note.pos-result-count,
+  .tactile-search kbd {
+    display: none;
+  }
+
+  .tactile-search.pos-search input {
+    padding-right: 14px;
+  }
+
+  .tactile-product-grid.pos-product-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .tactile-product-card.pos-product-card {
+    min-height: 132px;
+    grid-template-columns: 86px minmax(0, 1fr);
+  }
+
+  .tactile-product-media.pos-product-media {
+    width: 86px;
+    min-height: 112px;
+  }
+
+  .tactile-cart-item.pos-cart-item {
+    grid-template-columns: 25px 40px minmax(0, 1fr) auto;
+  }
+}
